# MediFlow clinic server settings. install_clinic_node.ps1 copies this to BackEnd/.env and fills it in.

# --- This server ---
NODE_MODE=clinic
SECRET_KEY=change-me
DEBUG=False
# The names and addresses staff use to reach this PC (comma separated).
ALLOWED_HOSTS=127.0.0.1,localhost
# One address for everything. Use 80 so staff type just the PC's address.
NODE_PORT=80
# Folder with the web app (made by `npm run build:node`). Default: dist-node next to BackEnd.
# FRONTEND_DIR=C:\MediFlow\dist-node

# --- Which clinic branch this is (must match the node token issued by Apex) ---
NODE_CLINIC_TIN=
NODE_BRANCH=Main

# --- The cloud ---
CLOUD_API_URL=https://mediflow-backend-delta.vercel.app/api
NODE_TOKEN=

# --- Local database ---
DB_NAME=mediflow_clinic
DB_USER=mediflow
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Windows service name of MySQL, so the starter can start it.
MYSQL_SERVICE=MySQL80

# --- Backups ---
# Leave BACKUP_DIR empty for a "backups" folder next to BackEnd.
BACKUP_DIR=
# A second disk or USB drive: every backup is copied here too (strongly recommended, e.g. E:\MediFlowBackups).
BACKUP_COPY_DIR=
BACKUP_KEEP_DAYS=7
# Only needed if mysqldump / mysql are not on PATH.
MYSQLDUMP_PATH=
MYSQL_PATH=

# Tokens for staff and manager sign-in stay on this server.
CORS_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
